    {
      "id": "al_jury_duty",
      "name": "Alabama Jury Duty Leave",
      "abbreviation": "AYJD",
      "statute_code": "Ala. Code § 12-16-1",
      "effective_date": "1975-01-01",
      "description": "Alabama prohibits employers from firing or penalizing employees for jury duty service.",
      "leave_types": [
        {
          "type": "jury_duty",
          "duration": {
            "value": 0,
            "unit": "days",
            "notes": "Duration depends on trial length"
          },
          "paid": false,
          "eligibility": {
            "min_employment_duration": "0",
            "other_requirements": [
              "Summoned for jury service"
            ]
          },
          "notice_requirement": "Court summons",
          "job_protection": true
        }
      ],
      "official_url": "https://www.alaocourts.org/",
