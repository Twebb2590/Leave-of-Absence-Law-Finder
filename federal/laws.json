    {
      "id": "fmla",
      "name": "Family and Medical Leave Act",
      "abbreviation": "FMLA",
      "statute_code": "29 U.S.C. § 2601 et seq.",
      "effective_date": "1993-08-05",
      "description": "Provides eligible employees with up to 12 weeks of unpaid, job-protected leave per year for specified medical and family reasons.",
      "leave_types": [
        {
          "type": "medical",
          "duration": { "value": 12, "unit": "weeks", "notes": "Per 12-month period" },
          "paid": false
        },
        {
          "type": "parental",
          "duration": { "value": 12, "unit": "weeks", "notes": "Per 12-month period" },
          "paid": false
        },
        {
          "type": "caregiving",
          "duration": { "value": 12, "unit": "weeks", "notes": "Per 12-month period for qualifying exigencies" },
          "paid": false
        }
      ],
      "job_protection": true,
      "eligibility": {
        "employer_size": "50+ employees within 75 miles",
        "employee_tenure": "12 months of employment",
        "hours_worked": "1,250 hours in the past 12 months",
        "notes": "Employee must work at a covered employer and meet all three criteria."
      },
      "official_url": "https://www.dol.gov/agencies/whd/fmla/",
      "type": ["medical","injury", "family", "pregnancy", "caregiving"],
      "last_updated": "2024-01-01T00:00:00Z"
    },
    {
      "id": "military_caregiver_leave",
