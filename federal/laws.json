      "abbreviation": "MCL",
      "statute_code": "29 U.S.C. § 2612(a)(3)",
      "effective_date": "2009-01-01",
      "description": "Provides eligible employees with up to 26 weeks of unpaid leave in a single 12-month period to care for a covered servicemember.",
      "leave_types": [
        {
          "type": "military",
          "duration": { "value": 26, "unit": "weeks", "notes": "Per single 12-month period" },
          "paid": false
        }
      ],
      "job_protection": true,
      "eligibility": {
        "employer_size": "50+ employees within 75 miles",
        "employee_tenure": "12 months of employment",
        "hours_worked": "1,250 hours in the past 12 months",
        "relationship_requirement": "Must be the spouse, parent, child, or next of kin of the servicemember",
        "notes": "Uses the same eligibility rules as FMLA, with additional family relationship requirements."
      },
      "official_url": "https://www.dol.gov/agencies/whd/fmla/military-caregiver-leave",
      "type": ["military", "caregiving"],
      "last_updated": "2024-01-01T00:00:00Z"
